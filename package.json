{
  "name": "photo-quest",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt build && wrangler dev",
    "postinstall": "nuxt prepare",
    "deploy": "nuxt build && wrangler deploy",
    "deploy:staging": "nuxt build && node scripts/staging-config.ts && wrangler deploy -c .output/server/wrangler.staging.json",
    "test": "vitest run",
    "check:api": "node scripts/api-check.ts",
    "verify": "pnpm typecheck && tsc -p tsconfig.scripts.json && pnpm test",
    "check:all": "node scripts/check-all.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote -c wrangler.staging.jsonc",
    "typecheck": "nuxt typecheck",
    "db:seed:local": "node scripts/seed.ts && wrangler d1 execute DB --local --file .wrangler/seed.sql",
    "db:seed:remote": "node scripts/seed.ts --base-url $APP_URL && wrangler d1 execute DB --remote --file .wrangler/seed.sql",
    "db:seed:staging": "node scripts/seed.ts --base-url $STAGING_URL && wrangler d1 execute DB --remote -c wrangler.staging.jsonc --file .wrangler/seed.sql",
    "db:reset:local": "rm -rf .wrangler/state && pnpm db:migrate:local && pnpm db:seed:local"
  },
  "dependencies": {
    "@lucide/vue": "1.66.0",
    "@vueuse/core": "^15.0.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.6.3",
    "nuxt-auth-utils": "^0.6.0",
    "reka-ui": "2.11.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "2.0.9"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "drizzle-kit": "^0.31.11",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "shadcn-nuxt": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.156.1"
  }
}
