# Copy to .env for local development. Production and staging set these as Worker secrets
# (wrangler secret put NAME, and -c wrangler.staging.jsonc for staging).

# The committee's sign-in passphrase. Long, since nothing else limits guesses.
NUXT_COMMITTEE_PASSPHRASE=
# Seals the committee's session cookie: at least 32 random characters.
NUXT_APP_SECRET=

# Not needed locally (`nuxt dev` uses a stand-in for R2's signed links). In production and on
# staging, an R2 API token with Object Read & Write on that environment's bucket only:
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# For scripts/staging-data.ts only: an R2 API token with Object Read & Write on the staging
# bucket. Named apart from the app's own, so local dev never writes to staging's bucket.
# STAGING_R2_ACCESS_KEY_ID=
# STAGING_R2_SECRET_ACCESS_KEY=

# Demo mode (docs/architecture.md): a public demo that strangers can try. Off unless "true".
# DEMO_MODE=true
